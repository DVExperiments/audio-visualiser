<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Windows audio capture + DSP sidecar. Talks to Electron over stdin/stdout (NDJSON).
    stdout carries protocol messages only; diagnostics go to stderr. Captured audio is never written anywhere.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AudioCapture</AssemblyName>
    <RootNamespace>AudioViz.Capture</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <Version>0.20.3</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- NAudio.Wasapi only (not the NAudio meta-package) so no WinForms/WindowsDesktop runtime is needed. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\libs\dsp-core\DspCore.csproj" />
  </ItemGroup>
</Project>
